{
  "name": "@qris-dinamis/core",
  "version": "1.6.0",
  "description": "EMVCo QRIS Static-to-Dynamic converter, QR renderer, webhook verifier, and typed API client SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/roedyrustam/qris-dinamis.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/roedyrustam/qris-dinamis/tree/main/packages/core#readme",
  "keywords": [
    "qris",
    "qris-dinamis",
    "emvco",
    "crc16",
    "tlv",
    "indonesia",
    "payment",
    "webhook"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.5"
  }
}
