{
  "name": "@qris-dinamis/react",
  "version": "2.2.0",
  "description": "Drop-in React checkout component and real-time SSE status hook for QRIS Dinamis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/roedyrustam/qris-dinamis.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/roedyrustam/qris-dinamis/tree/main/packages/react#readme",
  "keywords": [
    "qris",
    "qris-dinamis",
    "react",
    "checkout",
    "sse",
    "indonesia",
    "payment"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
