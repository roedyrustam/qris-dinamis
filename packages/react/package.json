    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@qris-dinamis/core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "react": "^19.0.0"
  }
}
