{
  "name": "@qris-dinamis/cli",
  "version": "1.9.0",
  "description": "CLI tool for converting, validating, and inspecting QRIS strings and testing signed webhooks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/roedyrustam/qris-dinamis.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/roedyrustam/qris-dinamis/tree/main/packages/cli#readme",
  "keywords": [
    "qris",
    "qris-dinamis",
    "cli",
    "emvco",
    "webhook",
    "indonesia"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "qris-dinamis": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@qris-dinamis/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.10"
  }
}
