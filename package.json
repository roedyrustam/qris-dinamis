{
  "name": "qris-dinamis-monorepo",
  "version": "1.1.0",
  "private": true,
  "description": "QRIS Static-to-Dynamic SDK, CLI, REST API & Webhook Engine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/roedyrustam/qris-dinamis.git"
  },
  "homepage": "https://github.com/roedyrustam/qris-dinamis#readme",
  "bugs": {
    "url": "https://github.com/roedyrustam/qris-dinamis/issues"
  },
  "keywords": [
    "qris",
    "qris-dinamis",
    "emvco",
    "indonesia-payment",
    "payment-gateway",
    "webhook",
    "hono",
    "typescript",
    "cli"
  ],
  "scripts": {
    "build": "pnpm -r --stream build",
    "dev": "pnpm --parallel --filter @qris-dinamis/api --filter @qris-dinamis/web dev",
    "test": "pnpm -r --stream test",
    "typecheck": "pnpm -r --stream typecheck"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
