# API Server Configuration
PORT=3001
DATABASE_URL=file:./data/qris.db
# Optional: set to postgres://user:pass@localhost:5432/qris for PostgreSQL
# DATABASE_DIALECT=sqlite

# Webhook & Security
REQUIRE_API_KEY=false
RATE_LIMIT_MAX=120
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMEOUT_MS=8000
DEFAULT_TX_TTL_SECONDS=900
CORS_ORIGIN=http://localhost:5173

# Optional: Redis Pub/Sub URL for multi-instance SSE fan-out
# REDIS_URL=redis://localhost:6379

# Official Payment Gateway Signature Verification (Optional)
# DOKU_SECRET_KEY=SK-...
# MIDTRANS_SERVER_KEY=SB-Mid-server-...
